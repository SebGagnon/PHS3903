        "# iteration QR\n",
        "def eig_qr(A, tol=1e-5):\n",
        "    Q, R = qr(A)\n",
        "    vs = Q\n",
        "    T = np.dot(R, Q)\n",
        "    l = T[0, 0]\n",
        "    diff = 1\n",
        "    i = 0\n",
        "    while diff > tol:\n",
        "        i += 1\n",
        "        Q, R = qr(T)\n",
        "        vs = np.dot(vs, Q)\n",
        "        T = np.dot(R, Q)\n",
        "        diff = abs(l - T[0, 0]) / abs(l)\n",
        "        l = T[0, 0]\n",
        "    ls = np.array([T[i, i] for i in range(len(T))])\n",
        "    return ls, vs, i\n",
