def run_multilateration(params_simul, objet, capteurs, affichage):

    # --- Simulations ---
    intensite_echo, t_hist, c_eau, h = methode_multilateration(
        params_simul           = params_simul,
        objet                  = objet,
        afficher_animation     = affichage["animation"],
        afficher_capteurs_flag = affichage["capteurs"],
)
    if affichage["echo"]:
        show_echo(intensite_echo, t_hist, capteurs, t_total)

    # --- Multilatération ---
    plages                   = get_plages_pulses(capteurs, t_total)
    positions_estimees       = []
    distances_par_pulse      = []
    t0_par_pulse             = []
    positions_reelles_impact = []
    t_impacts                = []

    for k, (idx_emit, t_debut_plage, t_fin_plage) in enumerate(plages):
        print(f"\n--- Pulse {k+1} | {capteurs[idx_emit]['nom']} | [{t_debut_plage:.3f}s, {t_fin_plage:.3f}s] ---")
        try:
            pos_m, _, distances, idx_emit_retour = multilateration_un_pulse(
                intensite_echo, t_hist, capteurs, c_eau,
                idx_emetteur  = idx_emit,
                t_debut_plage = t_debut_plage,
                t_fin_plage   = t_fin_plage,
                h             = h   # ← h correct pour ce maillage
            )
            position_impact_m, t_impact = calc_position_reelle_impact(
                objet=objet, t0_emit=t_debut_plage,
                d_emetteur=distances[idx_emit_retour], c_eau=c_eau
            )

            positions_estimees.append(pos_m)
            distances_par_pulse.append(distances)
            t0_par_pulse.append(t_debut_plage)
            positions_reelles_impact.append(position_impact_m)
            t_impacts.append(t_impact)

            erreur = np.linalg.norm(pos_m - position_impact_m)
            print(f"  Position réelle  : {position_impact_m} m  (t={t_impact:.3f}s)")
            print(f"  Position estimée : {pos_m} m")
            print(f"  Erreur           : {erreur:.2f} m")

            if affichage["localisation"]:
                plot_localisation_echo(
                    capteurs=capteurs, position_estimee_m=pos_m, objet=objet,
                    distances_m=distances, t0_emit=t_debut_plage,
                    d_emetteur=distances[idx_emit_retour], c_eau=c_eau, L=L
                )

        except ValueError as e:
            print(f"  ⚠ Ignoré : {e}")

    if affichage["positions"] and len(positions_estimees) >= 1:
        plot_positions_estimees(
            capteurs=capteurs, positions_estimees_m=positions_estimees,
            positions_reelles_impact=positions_reelles_impact,
            t_impacts=t_impacts, t0_par_pulse=t0_par_pulse, objet=objet, L=L
        )

    if affichage["vitesse"] and len(positions_estimees) >= 2:
        estimer_vitesse(positions_estimees, t_impacts, objet)


